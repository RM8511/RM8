-- 1. حلقة فحص التعبئة المستقلة (تشتغل دائماً سواء حددت أزرار أو لا)
task.spawn(function()
    while task.wait(0.3) do
        if not IsRefueling then
            local vehModel, seat = GetVehicle()
            if vehModel and seat then
                local isFuelEmpty = CheckFuelUI() or (seat.ThrottleFloat > 0 and seat.AssemblyLinearVelocity.Magnitude < 1)
                
                if isFuelEmpty then
                    IsRefueling = true
                    
                    -- الانتقال الفوري للمحطة
                    SafeTeleport(vehModel, GasStationCFrame)
                    task.wait(4.5) -- انتظر التعبئة فل
                    
                    -- إذا كان المكان الأول محدد والتجميع مفعّل، يرجع له تلقائياً
                    if PointA and AutoFarmEnabled then
                        SafeTeleport(vehModel, PointA)
                    end
                    
                    IsRefueling = false
                end
            end
        end
    end
end)

