-- // الوظائف والبرمجة الحماية (Pcall Protection)
-- // ================================================

-- التحقق الآمن من مقعد المركبة
local function GetVehicle()
    local success, result = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seat = char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") and seat.Parent then
                return seat.Parent
            end
        end
        return nil
    end)
    return success and result or nil
end

-- حدث الضغط على زر التشغيل/الإيقاف
ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmEnabled = not AutoFarmEnabled
    
    if AutoFarmEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 50) -- أخضر (ON)
        ToggleButton.Text = "بداية التجميع: (ON)"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- أحمر (OFF)
        ToggleButton.Text = "بداية التجميع: (OFF)"
    end
end)

-- // ================================================
-- // حلقة التجميع التلقائي للشارع المستقيم
-- // ================================================

task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled then
            local veh = GetVehicle()
            if veh then
                local root = veh.PrimaryPart or veh:FindFirstChildWhichIsA("BasePart")
                if root then
                    local startCFrame = root.CFrame
                    local forwardVec = root.CFrame.LookVector
                    local movedDistance = 0
                    
                    -- القيادة في خط مستقيم
                    while AutoFarmEnabled and movedDistance < LoopDistance do
                        local currentVeh = GetVehicle()
                        if not currentVeh or currentVeh ~= veh then break end
                        
                        root.AssemblyLinearVelocity = forwardVec * DrivingSpeed
                        movedDistance = movedDistance + (DrivingSpeed * 0.03)
                        RunService.RenderStepped:Wait()
                    end
                    
                    -- العودة لنقطة البداية بشكل آمن بدون الانقلاب أو الطيران
                    if GetVehicle() == veh then
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        root.CFrame = startCFrame
                        task.wait(0.2)
                    end
                end
            end
        end
    end
end)
