-- جلب مقعد القيادة والهيكل بأمان
local function GetVehicleData()
    local success, result = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seat = char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") and seat.Parent then
                return seat, seat.Parent.PrimaryPart or seat.Parent:FindFirstChildWhichIsA("BasePart")
            end
        end
        return nil, nil
    end)
    if success then return result end
    return nil, nil
end

ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmEnabled = not AutoFarmEnabled
    
    if AutoFarmEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
        ToggleButton.Text = "بداية التجميع: (ON)"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleButton.Text = "بداية التجميع: (OFF)"
        
        -- إيقاف التحكم بآمان عند الإطفاء بدون إسقاط الموتر تحت الأرض
        local seat, root = GetVehicleData()
        if seat then
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
        end
    end
end)

-- حلقة الحركة الذهاب والإياب بنفس طريقة الفيديو وبسرعة 160
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled then
            local seat, root = GetVehicleData()
            if seat and root then
                local forwardVec = root.CFrame.LookVector
                local startPos = root.CFrame
                local currentMoved = 0
                
                -- 1. الذهاب للأمام بسرعة 160 كم/س
                while AutoFarmEnabled and currentMoved < DriveDistance do
                    local curSeat, curRoot = GetVehicleData()
                    if not curSeat or curSeat ~= seat then break end
                    
                    -- تطبيق سرعة محسوبة بآمان (160 كم/س = ~100 studs/s)
                    curRoot.AssemblyLinearVelocity = forwardVec * 100
                    currentMoved = currentMoved + 5
                    RunService.RenderStepped:Wait()
                end
                
                task.wait(0.1)
                
                -- 2. العودة لنقطة البداية (خط المشاة) بنفس الطريقة
                while AutoFarmEnabled and currentMoved > 0 do
                    local curSeat, curRoot = GetVehicleData()
                    if not curSeat or curSeat ~= seat then break end
                    
                    curRoot.AssemblyLinearVelocity = -forwardVec * 100
                    currentMoved = currentMoved - 5
                    RunService.RenderStepped:Wait()
                end
                
                -- إيقاف الفيزياء اللحظية لمنع الاهتزاز عند نقطة البداية
                local finalSeat, finalRoot = GetVehicleData()
                if finalRoot and AutoFarmEnabled then
                    finalRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end)
