-- حلقة الحركة للتجميع بأعلى سرعة مدعومة
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoFarmEnabled and PointA and PointB and not IsRefueling then
            local vehModel, seat = GetVehicle()
            if vehModel and seat then
                SafeTeleport(vehModel, PointA)
                task.wait(0.2)
                
                while AutoFarmEnabled and not IsRefueling do
                    local currentModel, currentSeat = GetVehicle()
                    if not currentModel or currentSeat ~= seat then break end
                    
                    local currentPos = currentSeat.Position
                    local targetPos = PointB.Position
                    local dist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
                    
                    -- قراءة أقصى سرعة للمقعد تلقائياً أو رفعها لأقصى حد للموتر
                    local maxSpeed = math.max(currentSeat.MaxSpeed * 2.5, 400)
                    
                    if dist > 35 then
                        local dir = (Vector3.new(targetPos.X, currentPos.Y, targetPos.Z) - currentPos).Unit
                        currentSeat.AssemblyLinearVelocity = Vector3.new(dir.X * maxSpeed, currentSeat.AssemblyLinearVelocity.Y, dir.Z * maxSpeed)
                    else
                        SafeTeleport(vehModel, PointA)
                        task.wait(0.2)
                    end
                    
                    task.wait(0.02)
                end
            end
        end
    end
end)
