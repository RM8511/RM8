-- حلقة تحديث العداد وفحص البنزين
task.spawn(function()
    while true do
        task.wait(0.5)
        local vehModel = GetVehicle()
        local fuel = CheckFuelLevel(vehModel)
        
        if AutoFarmEnabled then
            local nowMoney = GetPlayerMoney()
            if nowMoney >= InitialMoney then
                CurrentEarned = nowMoney - InitialMoney
            end
            ProfitLabel.Text = "الأرباح: +$" .. tostring(CurrentEarned) .. "\nحالة البنزين: " .. math.floor(fuel) .. "%"
            
            if fuel <= 5 and GasStationPoint and not IsRefueling then
                GoRefuel()
            end
        else
            ProfitLabel.Text = "الأرباح: $0\nحالة البنزين: " .. math.floor(fuel) .. "%"
        end
    end
end)

-- حلقة الحركة للتجميع بسررعة 185
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoFarmEnabled and PointA and PointB and not IsRefueling then
            local vehModel, seat = GetVehicle()
            if vehModel and seat then
                SafeTeleport(vehModel, PointA)
                task.wait(0.2)
                
                while AutoFarmEnabled and not IsRefueling do
                    local currentModel, currentSeat = GetVehicle()
                    if not currentModel or currentSeat ~= seat then break end
                    
                    local currentPos = currentSeat.Position
                    local targetPos = PointB.Position
                    local dist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
                    
                    if dist > 30 then
                        local dir = (Vector3.new(targetPos.X, currentPos.Y, targetPos.Z) - currentPos).Unit
                        currentSeat.AssemblyLinearVelocity = Vector3.new(dir.X * TargetMaxSpeed, currentSeat.AssemblyLinearVelocity.Y, dir.Z * TargetMaxSpeed)
                    else
                        SafeTeleport(vehModel, PointA)
                        task.wait(0.2)
                    end
                    
                    task.wait(0.02)
                end
            end
        end
    end
end)
