local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "RM8 HUB | عالم المملكة",
   LoadingTitle = "جاري تحميل السكربت...",
   LoadingSubtitle = "بواسطة RM8",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

-- // المتغيرات الأساسية
local GasFarmEnabled = false
local GasSpotCFrame = nil

local CurrentRollAngle = 0
local TargetRollAngle = 0

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function GetVehicle()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local seat = char.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") and seat.Parent then
            local root = seat.Parent.PrimaryPart or seat
            return seat.Parent, seat, root
        end
    end
    return nil, nil, nil
end

-- ================================================
-- 1. تبويب تعبئة البنزين والتجميع (Gas Farm Tab)
-- ================================================
local FarmTab = Window:CreateTab("تعبئة البنزين والتجميع", 4483362458)

local SaveGasSpotBtn = FarmTab:CreateButton({
   Name = "حفظ موقع محطة البنزين (قف عند نقطة التعبئة واضغط)",
   Callback = function()
      local _, seat, root = GetVehicle()
      if root then
         GasSpotCFrame = root.CFrame
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ موقع محطة البنزين بنجاح!", Duration = 3})
      else
         Rayfield:Notify({Title = "خطأ", Content = "يجب أن تكون راكباً للسيارة!", Duration = 3})
      end
   end,
})

local GasFarmToggle = FarmTab:CreateToggle({
   Name = "تفعيل التعبئة والتجميع التلقائي (Auto Refill & Farm)",
   CurrentValue = false,
   Flag = "GasFarmToggle",
   Callback = function(Value)
      if Value and not GasSpotCFrame then
         Rayfield:Notify({Title = "تنبيه", Content = "احفظ موقع محطة البنزين أولاً!", Duration = 3})
         return
      end
      GasFarmEnabled = Value
   end,
})

-- ================================================
-- 2. تبويب الترفيع والتوازن (Stunt Tab)
-- ================================================
local TiltTab = Window:CreateTab("الترفيع والتوازن", 4483362458)

local TiltRightToggle = TiltTab:CreateToggle({
   Name = "ترفيع لليمين (اضغط للرفع / اضغط للإلغاء)",
   CurrentValue = false,
   Flag = "TiltRight",
   Callback = function(Value)
      if Value then
         TargetRollAngle = -50
      else
         TargetRollAngle = 0
      end
   end,
})

local TiltLeftToggle = TiltTab:CreateToggle({
   Name = "ترفيع لليسار (اضغط للرفع / اضغط للإلغاء)",
   CurrentValue = false,
   Flag = "TiltLeft",
   Callback = function(Value)
      if Value then
         TargetRollAngle = 50
      else
         TargetRollAngle = 0
      end
   end,
})

-- ================================================
-- المحرك الفيزيائي (Heartbeat Loop)
-- ================================================
RunService.Heartbeat:Connect(function(dt)
    local model, seat, root = GetVehicle()
    
    if model and seat and root then
        -- 1. نظام التعبئة التلقائية عند المحطة
        if GasFarmEnabled and GasSpotCFrame then
            root.CFrame = GasSpotCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        
        -- 2. نظام الترفيع بالضغطة الواحدة
        CurrentRollAngle = CurrentRollAngle + (TargetRollAngle - CurrentRollAngle) * math.clamp(dt * 8, 0, 1)
        
        if math.abs(CurrentRollAngle) > 0.1 and not GasFarmEnabled then
            local currentCFrame = root.CFrame
            local rx, ry, rz = currentCFrame:ToOrientation()
            root.CFrame = CFrame.new(currentCFrame.Position) * CFrame.Angles(rx, ry, math.rad(CurrentRollAngle))
        end
    end
end)
