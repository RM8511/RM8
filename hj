-- // 6. منطق ووظائف الفيزيا والتجميع
local TiltActive = false
local TiltAngle = 35
local FarmActive = false
local PointA, PointB = nil, nil

local function GetVehicle()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local seat = char.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") and seat.Parent then
            local root = seat.Parent.PrimaryPart or seat
            return seat.Parent, seat, root
        end
    end
    return nil, nil, nil
end

-- تشغيل وإيقاف الترفيع
TiltToggleBtn.MouseButton1Click:Connect(function()
    TiltActive = not TiltActive
    TiltToggleBtn.Text = TiltActive and "الترفيع (شغال)" or "الترفيع (إيقاف)"
    TiltToggleBtn.BackgroundColor3 = TiltActive and Color3.fromRGB(0, 150, 70) or Color3.fromRGB(40, 40, 40)
end)

-- تحريك السلايدر
local dragging = false
SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local posX = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(posX, 0, 1, 0)
        TiltAngle = math.floor(posX * 60)
        SliderLabel.Text = "نسبة الترفيع: " .. tostring(TiltAngle) .. "°"
    end
end)

-- أزرار التجميع
PointABtn.MouseButton1Click:Connect(function()
    local _, _, root = GetVehicle()
    if root then PointA = root.CFrame PointABtn.Text = "تم الحفظ 1" end
end)

PointBBtn.MouseButton1Click:Connect(function()
    local _, _, root = GetVehicle()
    if root then PointB = root.CFrame PointBBtn.Text = "تم الحفظ 2" end
end)

FarmToggleBtn.MouseButton1Click:Connect(function()
    if not PointA or not PointB then return end
    FarmActive = not FarmActive
    FarmToggleBtn.Text = FarmActive and "التجميع (شغال)" or "التجميع (إيقاف)"
    FarmToggleBtn.BackgroundColor3 = FarmActive and Color3.fromRGB(0, 150, 70) or Color3.fromRGB(40, 40, 40)
end)

-- // 7. المحرك الفيزيائي
local bg = Instance.new("BodyGyro")
bg.MaxTorque = Vector3.new(0, 0, 9e9)
bg.P = 20000
local lastTeleport = tick()

RunService.RenderStepped:Connect(function()
    local model, seat, root = GetVehicle()
    
    if model and seat and root then
        if FarmActive and PointA and PointB then
            if tick() - lastTeleport > 0.2 then
                root.CFrame = (root.CFrame == PointA) and PointB or PointA
                lastTeleport = tick()
            end
            return
        end
        
        if TiltActive then
            bg.Parent = root
            local roll = math.rad(-TiltAngle)
            local _, yaw, _ = root.CFrame:ToOrientation()
            
            for _, part in pairs(model:GetDescendants()) do
                if part:IsA("BasePart") and part ~= root then
                    part.CanCollide = false
                end
            end
            
            bg.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, roll)
        else
            bg.Parent = nil
            for _, part in pairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    else
        bg.Parent = nil
    end
end)
