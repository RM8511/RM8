local function GetVehicle()
    local success, result = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seat = char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") and seat.Parent then
                return seat.Parent
            end
        end
        return nil
    end)
    return success and result or nil
end

ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmEnabled = not AutoFarmEnabled
    
    if AutoFarmEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
        ToggleButton.Text = "بداية التجميع: (ON)"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleButton.Text = "بداية التجميع: (OFF)"
    end
end)

-- حلقة التجميع: قيادة للأمام ثم العودة للخلف (ريوس)
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled then
            local veh = GetVehicle()
            if veh then
                local root = veh.PrimaryPart or veh:FindFirstChildWhichIsA("BasePart")
                if root then
                    local forwardVec = root.CFrame.LookVector
                    local distanceTraveled = 0
                    
                    -- 1. الذهاب للأمام لين نهاية الطريق
                    while AutoFarmEnabled and distanceTraveled < RoadLength do
                        local currentVeh = GetVehicle()
                        if not currentVeh or currentVeh ~= veh then break end
                        
                        root.AssemblyLinearVelocity = forwardVec * DrivingSpeed
                        distanceTraveled = distanceTraveled + (DrivingSpeed * 0.03)
                        RunService.RenderStepped:Wait()
                    end
                    
                    task.wait(0.2)
                    
                    -- 2. الرجوع للخلف (ريوس) لنفس خط البداية
                    while AutoFarmEnabled and distanceTraveled > 0 do
                        local currentVeh = GetVehicle()
                        if not currentVeh or currentVeh ~= veh then break end
                        
                        root.AssemblyLinearVelocity = -forwardVec * DrivingSpeed
                        distanceTraveled = distanceTraveled - (DrivingSpeed * 0.03)
                        RunService.RenderStepped:Wait()
                    end
                    
                    if GetVehicle() == veh then
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
        end
    end
end)
