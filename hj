local function GetPlayerMoney()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, v in ipairs(leaderstats:GetChildren()) do
            if string.find(string.lower(v.Name), "cash") or string.find(string.lower(v.Name), "money") or v.Name == "فلوس" or v.Name == "الأرباح" then
                return v.Value
            end
        end
    end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, v in ipairs(playerGui:GetDescendants()) do
            if v:IsA("TextLabel") and string.find(v.Text, "$") then
                local num = tonumber(string.gsub(v.Text, "[^%d]", ""))
                if num then return num end
            end
        end
    end
    return 0
end

local function GetVehicle()
    local success, model, seat = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seatPart = char.Humanoid.SeatPart
            if seatPart and seatPart:IsA("VehicleSeat") and seatPart.Parent then
                return seatPart.Parent, seatPart
            end
        end
        return nil, nil
    end)
    if success then return model, seat end
    return nil, nil
end

local function CheckFuelLevel(model)
    if not model then return 100 end
    for _, obj in ipairs(model:GetDescendants()) do
        if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and (string.find(string.lower(obj.Name), "fuel") or string.find(string.lower(obj.Name), "gas")) then
            return obj.Value
        end
    end
    return 100
end

local function SafeTeleport(model, targetCFrame)
    if model and targetCFrame then
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        model:PivotTo(targetCFrame + Vector3.new(0, 2, 0))
        task.wait(0.1)
    end
end

