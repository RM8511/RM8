task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled and PointA and PointB then
            local vehModel, seat = GetVehicle()
            if vehModel and seat then
                SafeTeleport(vehModel, PointA)
                task.wait(0.1)
                
                while AutoFarmEnabled do
                    local currentModel, currentSeat = GetVehicle()
                    if not currentModel or currentModel ~= vehModel then break end
                    
                    local currentPos = currentSeat.Position
                    local targetPos = PointB.Position
                    
                    local dist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
                    
                    if dist > 25 then
                        local dir = (Vector3.new(targetPos.X, currentPos.Y, targetPos.Z) - currentPos).Unit
                        
                        -- دفع السرعة لتوصل 160 كم/س مباشرة
                        currentSeat.AssemblyLinearVelocity = Vector3.new(dir.X * (MoveSpeed * 1.15), currentSeat.AssemblyLinearVelocity.Y, dir.Z * (MoveSpeed * 1.15))
                        currentModel:PivotTo(CFrame.new(currentPos, Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)))
                    else
                        SafeTeleport(vehModel, PointA)
                        task.wait(0.1)
                    end
                    
                    RunService.RenderStepped:Wait()
                end
            end
        end
    end
end)
