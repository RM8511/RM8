    StatusLabel.Text = DriveFarmEnabled and "التجميع السريع شغال بين النقطتين ⚡" or "التجميع متوقف"
end)

-- حلقة التحرك المباشر والسريع
RunService.Heartbeat:Connect(function()
    if DriveFarmEnabled and PointA and PointB then
        local vehModel, seat = GetVehicle()
        if vehModel and seat then
            local currentPos = seat.Position
            local dist = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(CurrentTarget.X, 0, CurrentTarget.Z)).Magnitude
            
            if dist < 15 then
                CurrentTarget = (CurrentTarget == PointA) and PointB or PointA
            end
            
            local dir = (CurrentTarget - currentPos).Unit
            seat.AssemblyLinearVelocity = Vector3.new(dir.X * TargetSpeed, seat.AssemblyLinearVelocity.Y, dir.Z * TargetSpeed)
        end
    end
end)
