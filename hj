local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "RM8 HUB | محاكي القيادة",
   LoadingTitle = "جاري تحميل السكربت...",
   LoadingSubtitle = "بواسطة RM8",
   Theme = "Dark",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

-- // المتغيرات الأساسية
local DriveFarmEnabled = false
local GasFarmEnabled = false
local PointA = nil
local PointB = nil
local CurrentTarget = nil
local GasSpotCFrame = nil

local TiltRightEnabled = false
local TiltLeftEnabled = false
local TiltPower = 2.5 -- نسبة الترفيع الاحتراضية

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function GetVehicle()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local seat = char.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") and seat.Parent then
            local root = seat.Parent.PrimaryPart or seat
            return seat.Parent, seat, root
        end
    end
    return nil, nil, nil
end

-- ================================================
-- 1. تبويب التجميع وتعبئة البنزين
-- ================================================
local FarmTab = Window:CreateTab("تجميع وسرعة", 4483362458)

FarmTab:CreateButton({
   Name = "1. حفظ النقطة الأولى (Point 1)",
   Callback = function()
      local _, seat = GetVehicle()
      if seat then
         PointA = seat.Position
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ النقطة 1 بنجاح!", Duration = 2})
      else
         Rayfield:Notify({Title = "خطأ", Content = "اركب السيارة أولاً!", Duration = 2})
      end
   end,
})

FarmTab:CreateButton({
   Name = "2. حفظ النقطة الثانية (Point 2)",
   Callback = function()
      local _, seat = GetVehicle()
      if seat then
         PointB = seat.Position
         CurrentTarget = PointB
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ النقطة 2 بنجاح!", Duration = 2})
      else
         Rayfield:Notify({Title = "خطأ", Content = "اركب السيارة أولاً!", Duration = 2})
      end
   end,
})

FarmTab:CreateToggle({
   Name = "تفعيل التجميع السريع (بين النقطة 1 و 2)",
   CurrentValue = false,
   Flag = "FarmToggle",
   Callback = function(Value)
      if Value and (not PointA or not PointB) then
         Rayfield:Notify({Title = "تنبيه", Content = "احفظ النقطة 1 والنقطة 2 أولاً!", Duration = 3})
         return
      end
      DriveFarmEnabled = Value
   end,
})

FarmTab:CreateSection("تعبئة البنزين والتجميع")

FarmTab:CreateButton({
   Name = "حفظ موقع محطة البنزين",
   Callback = function()
      local _, seat, root = GetVehicle()
      if root then
         GasSpotCFrame = root.CFrame
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ موقع البنزين!", Duration = 2})
      end
   end,
})

FarmTab:CreateToggle({
   Name = "تفعيل تعبئة البنزين التلقائية",
   CurrentValue = false,
   Flag = "GasToggle",
   Callback = function(Value)
      GasFarmEnabled = Value
   end,
})

-- ================================================
-- 2. تبويب الترفيع (مطابق للمقطع بالنسبة والوزن)
-- ================================================
local TiltTab = Window:CreateTab("الترفيع والتوازن", 4483362458)

TiltTab:CreateSlider({
   Name = "نسبة وقوة الترفيع (Tilt Power)",
   Range = {0.5, 10},
   Increment = 0.1,
   Suffix = "x",
   CurrentValue = 2.5,
   Flag = "TiltPowerSlider",
   Callback = function(Value)
      TiltPower = Value
   end,
})

TiltTab:CreateToggle({
   Name = "ترفيع لليمين ➔",
   CurrentValue = false,
   Flag = "TiltRight",
   Callback = function(Value)
      TiltRightEnabled = Value
      if Value then TiltLeftEnabled = false end
   end,
})

TiltTab:CreateToggle({
   Name = "ترفيع لليسار ⬅",
   CurrentValue = false,
   Flag = "TiltLeft",
   Callback = function(Value)
      TiltLeftEnabled = Value
      if Value then TiltRightEnabled = false end
   end,
})

-- ================================================
-- المحرك الفيزيائي
-- ================================================
RunService.Heartbeat:Connect(function(dt)
    local model, seat, root = GetVehicle()
    
    if model and seat and root then
        -- 1. تعبئة البنزين
        if GasFarmEnabled and GasSpotCFrame then
            root.CFrame = GasSpotCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        
        -- 2. التجميع التلقائي
        if DriveFarmEnabled and PointA and PointB and not GasFarmEnabled then
            local currentPos = seat.Position
            local dist = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(CurrentTarget.X, 0, CurrentTarget.Z)).Magnitude
            if dist < 15 then
                CurrentTarget = (CurrentTarget == PointA) and PointB or PointA
            end
            local dir = (CurrentTarget - currentPos).Unit
            seat.AssemblyLinearVelocity = Vector3.new(dir.X * 180, seat.AssemblyLinearVelocity.Y, dir.Z * 180)
        end
        
        -- 3. تطبيق الترفيع المباشر بمركز كتلة السيارة (Center Offset)
        if (TiltRightEnabled or TiltLeftEnabled) and not GasFarmEnabled then
            local sideVector = TiltRightEnabled and root.CFrame.RightVector or -root.CFrame.RightVector
            root.AssemblyAngularVelocity = root.CFrame.LookVector * (TiltPower * 1.5)
            root:ApplyImpulseAtPosition(sideVector * (TiltPower * 150), root.Position + Vector3.new(0, -1, 0))
        end
    end
end)
