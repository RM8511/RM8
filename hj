-- دالة جلب المركبة وجزء الهيكل الأساسي
local function GetVehicleData()
    local success, seat, root = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seatPart = char.Humanoid.SeatPart
            if seatPart and seatPart:IsA("VehicleSeat") and seatPart.Parent then
                local model = seatPart.Parent
                local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                return seatPart, primary
            end
        end
        return nil, nil
    end)
    if success then return seat, root end
    return nil, nil
end

ToggleButton.MouseButton1Click:Connect(function()
    AutoFarmEnabled = not AutoFarmEnabled
    
    if AutoFarmEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 50)
        ToggleButton.Text = "بداية التجميع: (ON)"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleButton.Text = "بداية التجميع: (OFF)"
    end
end)

-- حلقة التجميع الرئيسية
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled then
            local seat, root = GetVehicleData()
            if seat and root then
                -- 1. حفظ موقع البداية والنقل الفوري له عند التشغيل
                local startCFrame = root.CFrame
                
                while AutoFarmEnabled do
                    local currentSeat, currentRoot = GetVehicleData()
                    if not currentSeat or currentRoot ~= root then break end
                    
                    -- مسار الذهاب (160 كم/س)
                    local moved = 0
                    while AutoFarmEnabled and moved < DriveDistance do
                        if not GetVehicleData() then break end
                        
                        -- دفع الموتر بسلاسة للأمام مع الحفاظ على ملاصقة الأرض
                        local currentLook = currentRoot.CFrame.LookVector
                        currentRoot.AssemblyLinearVelocity = Vector3.new(currentLook.X * TargetSpeed, currentRoot.AssemblyLinearVelocity.Y, currentLook.Z * TargetSpeed)
                        
                        moved = moved + 20
                        RunService.RenderStepped:Wait()
                    end
                    
                    -- 2. التدواير الفوري (180 درجة) بدون إيقاف الموتر أو تهدئة
                    if AutoFarmEnabled and GetVehicleData() then
                        currentRoot.CFrame = currentRoot.CFrame * CFrame.Angles(0, math.rad(180), 0)
                    end
                    
                    task.wait(0.05)
                end
            end
        end
    end
end)
