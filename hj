    end
end)

-- حلقة التجميع والقيادة بين النقطتين
task.spawn(function()
    while task.wait(0.1) do
        if AutoFarmEnabled and PointA and PointB then
            local seat, root = GetVehicleData()
            if seat and root then
                -- 1. الانتقال فوراً للمكان الأول
                root.CFrame = PointA
                task.wait(0.1)
                
                while AutoFarmEnabled do
                    local currentSeat, currentRoot = GetVehicleData()
                    if not currentSeat or currentRoot ~= root then break end
                    
                    -- حساب الاتجاه المسار والمسافة نحو المكان الثاني
                    local targetPos = PointB.Position
                    local currentPos = currentRoot.Position
                    local distance = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude
                    
                    -- المشي باتجاه المكان الثاني بسرعة 160 كم/س
                    if distance > 15 then
                        local moveDirection = (Vector3.new(targetPos.X, currentPos.Y, targetPos.Z) - currentPos).Unit
                        currentRoot.AssemblyLinearVelocity = Vector3.new(moveDirection.X * TargetSpeed, currentRoot.AssemblyLinearVelocity.Y, moveDirection.Z * TargetSpeed)
                        
                        -- توجيه الموتر باتجاه الهدف لثبات الفيزيا
                        currentRoot.CFrame = CFrame.new(currentRoot.Position, Vector3.new(targetPos.X, currentRoot.Position.Y, targetPos.Z))
                    else
                        -- 2. عند الوصول للمكان الثاني يتم العودة فوراً للمكان الأول
                        currentRoot.CFrame = PointA
                        task.wait(0.05)
                    end
                    
                    RunService.RenderStepped:Wait()
                end
            end
        end
    end
end)
