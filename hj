-- الحصول على السيارة والمركبة
local function GetVehicle()
    local success, model, seat = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seatPart = char.Humanoid.SeatPart
            if seatPart and seatPart:IsA("VehicleSeat") and seatPart.Parent then
                return seatPart.Parent, seatPart
            end
        end
        return nil, nil
    end)
    if success then return model, seat end
    return nil, nil
end

-- الانتقال الآمن
local function SafeTeleport(model, targetCFrame)
    if model and targetCFrame then
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        model:PivotTo(targetCFrame + Vector3.new(0, 2, 0))
    end
end

-- قبول طلبات التاكسي تلقائياً من الجوال
local function AutoAcceptTaxi()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return false end
    
    for _, btn in ipairs(pGui:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local text = btn:IsA("TextButton") and btn.Text or btn.Name
            if string.find(text, "قبول") or string.find(string.lower(text), "accept") then
                pcall(function()
                    for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                        conn:Fire()
                    end
                end)
                return true
            end
        end
    end
    return false
end

-- البحث عن المربع الأخضر بالخريطة
local function GetTaxiTargetCFrame()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "TaxiZone" or obj.Name == "CustomerZone" or string.find(string.lower(obj.Name), "checkpoint") or string.find(string.lower(obj.Name), "dropoff") or string.find(string.lower(obj.Name), "pickup")) then
            if obj.Transparency < 1 and (obj.Color == Color3.fromRGB(0, 255, 0) or obj.BrickColor.Name == "Br. green" or obj.BrickColor.Name == "Lime green") then
                return obj.CFrame
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") or v:IsA("Beam") then
            local p = v.Parent
            if p and p:IsA("BasePart") then
                return p.CFrame
            end
        end
    end
    return nil
end

