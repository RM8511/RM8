-- الحصول على المركبة
local function GetVehicle()
    local success, model, seat = pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local seatPart = char.Humanoid.SeatPart
            if seatPart and seatPart:IsA("VehicleSeat") and seatPart.Parent then
                return seatPart.Parent, seatPart
            end
        end
        return nil, nil
    end)
    if success then return model, seat end
    return nil, nil
end

-- حفظ ومسح النقاط
SavePointsBtn.MouseButton1Click:Connect(function()
    local _, seat = GetVehicle()
    if not seat then
        StatusLabel.Text = "خطأ: يجب أن تكون راكباً للسيارة لحفظ النقاط!"
        return
    end
    
    if not PointA then
        PointA = seat.Position
        StatusLabel.Text = "تم حفظ النقطة الأولى (A) ✓\nتحرك للموقع الثاني واضغط حفظ مجدداً."
    elseif not PointB then
        PointB = seat.Position
        CurrentTarget = PointB
        StatusLabel.Text = "تم حفظ النقطتين (A) و (B) بنجاح ✓\nيمكنك الآن تشغيل التجميع!"
    else
        StatusLabel.Text = "النقاط محفوظة بالفعل! استخدم زر المسح لإعادتها."
    end
end)

