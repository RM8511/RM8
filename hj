-- حلقة الحركة بين النقطتين A و B
RunService.Heartbeat:Connect(function()
    if DriveFarmEnabled and PointA and PointB then
        local vehModel, seat = GetVehicle()
        if vehModel and seat then
            local currentPos = seat.Position
            local dist = (Vector3.new(currentPos.X, 0, currentPos.Z) - Vector3.new(CurrentTarget.X, 0, CurrentTarget.Z)).Magnitude
            
            if dist < 15 then
                CurrentTarget = (CurrentTarget == PointA) and PointB or PointA
            end
            
            local dir = (CurrentTarget - currentPos).Unit
            seat.AssemblyLinearVelocity = Vector3.new(dir.X * TargetSpeed, seat.AssemblyLinearVelocity.Y, dir.Z * TargetSpeed)
        end
    end
end)

-- حلقة التاكسي التلقائي
task.spawn(function()
    while true do
        task.wait(0.5)
        if TaxiFarmEnabled and not IsTaxiBusy then
            local vehModel, seat = GetVehicle()
            
            if not vehModel then
                StatusLabel.Text = "الحالة: اركب السيارة لتشغيل التاكسي!"
            else
                StatusLabel.Text = "الحالة: البحث عن طلبات تاكسي... 🚕"
                AutoAcceptTaxi()
                
                local targetCFrame = GetTaxiTargetCFrame()
                if targetCFrame then
                    IsTaxiBusy = true
                    StatusLabel.Text = "الحالة: الانتقال للمربع الأخضر..."
                    
                    SafeTeleport(vehModel, targetCFrame)
                    
                    for i = 3, 1, -1 do
                        StatusLabel.Text = "الحالة: الانتظار بالمربع (" .. i .. " ث)..."
                        task.wait(1)
                    end
                    
                    StatusLabel.Text = "الحالة: اكتملت النقطة بنجاح ✓"
                    task.wait(0.5)
                    IsTaxiBusy = false
                end
            end
        end
    end
end)
