local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "RM8 HUB | محاكي القيادة",
   LoadingTitle = "جاري تحميل السكربت...",
   LoadingSubtitle = "بواسطة RM8",
   Theme = "Dark",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

-- // المتغيرات الأساسية
local DriveFarmEnabled = false
local GasFarmEnabled = false
local PointA = nil
local PointB = nil
local CurrentTarget = nil
local GasSpotCFrame = nil

local TiltRightEnabled = false
local TiltLeftEnabled = false
local TiltAngle = 45

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function GetVehicle()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local seat = char.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") and seat.Parent then
            local root = seat.Parent.PrimaryPart or seat
            return seat.Parent, seat, root
        end
    end
    return nil, nil, nil
end

-- ================================================
-- 1. تبويب التجميع بالتنقل السريع (Teleport)
-- ================================================
local FarmTab = Window:CreateTab("تجميع وسرعة", 4483362458)

FarmTab:CreateButton({
   Name = "1. حفظ النقطة الأولى (Point 1)",
   Callback = function()
      local _, _, root = GetVehicle()
      if root then
         PointA = root.CFrame
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ النقطة 1 بنجاح!", Duration = 2})
      else
         Rayfield:Notify({Title = "خطأ", Content = "اركب السيارة أولاً!", Duration = 2})
      end
   end,
})

FarmTab:CreateButton({
   Name = "2. حفظ النقطة الثانية (Point 2)",
   Callback = function()
      local _, _, root = GetVehicle()
      if root then
         PointB = root.CFrame
         CurrentTarget = PointB
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ النقطة 2 بنجاح!", Duration = 2})
      else
         Rayfield:Notify({Title = "خطأ", Content = "اركب السيارة أولاً!", Duration = 2})
      end
   end,
})

FarmTab:CreateToggle({
   Name = "تفعيل التجميع بالتنقل السريع (Teleport Farm)",
   CurrentValue = false,
   Flag = "FarmToggle",
   Callback = function(Value)
      if Value and (not PointA or not PointB) then
         Rayfield:Notify({Title = "تنبيه", Content = "احفظ النقطة 1 والنقطة 2 أولاً!", Duration = 3})
         return
      end
      DriveFarmEnabled = Value
   end,
})

FarmTab:CreateSection("تعبئة البنزين والتجميع")

FarmTab:CreateButton({
   Name = "حفظ موقع محطة البنزين",
   Callback = function()
      local _, _, root = GetVehicle()
      if root then
         GasSpotCFrame = root.CFrame
         Rayfield:Notify({Title = "RM8", Content = "تم حفظ موقع البنزين!", Duration = 2})
      end
   end,
})

FarmTab:CreateToggle({
   Name = "تفعيل تعبئة البنزين التلقائية",
   CurrentValue = false,
   Flag = "GasToggle",
   Callback = function(Value)
      GasFarmEnabled = Value
   end,
})

-- ================================================
-- 2. تبويب الترفيع (سلايدر سلس وسريع نفس المقطع)
-- ================================================
local TiltTab = Window:CreateTab("الترفيع والتوازن", 4483362458)

local TiltSlider = TiltTab:CreateSlider({
   Name = "نسبة وزاوية الترفيع",
   Range = {0, 90},
   Increment = 0.5,
   Suffix = "°",
   CurrentValue = 45,
   Flag = "SmoothTiltSlider",
   Callback = function(Value)
      TiltAngle = Value
   end,
})

TiltTab:CreateToggle({
   Name = "ترفيع لليمين ➔",
   CurrentValue = false,
   Flag = "TiltRight",
   Callback = function(Value)
      TiltRightEnabled = Value
      if Value then TiltLeftEnabled = false end
   end,
})

TiltTab:CreateToggle({
   Name = "ترفيع لليسار ⬅",
   CurrentValue = false,
   Flag = "TiltLeft",
   Callback = function(Value)
      TiltLeftEnabled = Value
      if Value then TiltRightEnabled = false end
   end,
})

-- ================================================
-- المحرك الفيزيائي المستقر والمستجيب بمرونة
-- ================================================
local lastTeleport = tick()

RunService.RenderStepped:Connect(function()
    local model, seat, root = GetVehicle()
    
    if model and seat and root then
        -- 1. تعبئة البنزين
        if GasFarmEnabled and GasSpotCFrame then
            root.CFrame = GasSpotCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            return
        end
        
        -- 2. التجميع السريع بالتنقل
        if DriveFarmEnabled and PointA and PointB then
            if tick() - lastTeleport > 0.2 then
                CurrentTarget = (CurrentTarget == PointA) and PointB or PointA
                root.CFrame = CurrentTarget
                root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                lastTeleport = tick()
            end
            return
        end
        
        -- 3. الترفيع الثابت والسلس بنفس الزاوية المحددة في السلايدر
        if TiltRightEnabled or TiltLeftEnabled then
            local radAngle = math.rad(TiltRightEnabled and -TiltAngle or TiltAngle)
            local currentPos = root.Position
            local _, yaw, _ = root.CFrame:ToOrientation()
            
            root.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, radAngle)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)
