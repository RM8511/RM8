local function GoRefuel()
    local vehModel, seat = GetVehicle()
    if not GasStationPoint then return end
    if vehModel and seat then
        IsRefueling = true
        SafeTeleport(vehModel, GasStationPoint)
        task.wait(5)
        if PointA and AutoFarmEnabled then
            SafeTeleport(vehModel, PointA)
        end
        IsRefueling = false
    end
end

