-- ================================================
-- حلقة التفريم
-- ================================================

task.spawn(function()
    while true do
        task.wait(0.1)
        if FullAutoEnabled and MacCFrame then
            -- 1. الانتقال للابتوب والضغط لأخذ الطلب
            InstantTP(MacCFrame)
            task.wait(0.3)
            
            ForceClickAllPrompts()
            task.wait(0.3)
            
            -- البحث عن المربع الأحمر
            local deliveryPart = nil
            local searchStart = tick()
            while FullAutoEnabled and not deliveryPart and (tick() - searchStart < 3) do
                task.wait(0.2)
                deliveryPart = GetRedDeliveryBox()
            end
            
            -- 2. الطيران للبيت
            if deliveryPart then
                local targetCF = deliveryPart.CFrame
                
                TweenTo(targetCF)
                
                -- 3. التسليم والرجوع
                if FullAutoEnabled then
                    task.wait(0.4)
                    ForceClickAllPrompts()
                    task.wait(0.4)
                    
                    InstantTP(MacCFrame)
                    task.wait(0.3)
                end
            end
        end
    end
end)
